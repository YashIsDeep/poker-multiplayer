# Copy this file to .env and populate the provider credentials.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Secure cookies default to true for production and OAuth. The dev/local-auth
# profiles allow HTTP cookies only on a direct loopback listener with no tunnel.
# For local OAuth over HTTP with SPRING_PROFILES_ACTIVE=dev,oauth, opt in:
# SESSION_COOKIE_SECURE=false
# Sessions expire after 12 hours of inactivity by default.

# Use guest login only on this computer; public listeners/tunnels require OAuth.
# OAUTH_ENABLED=false

# Optional production overrides:
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=oauth

# Optional remote development tunnel. `npm run dev:proxy` uses the locked
# localtunnel development dependency by default; cloudflared and ngrok are also supported.
# TUNNEL_PROVIDER=localtunnel
# TUNNEL_TARGET=http://127.0.0.1:5173
# TUNNEL_SUBDOMAIN=my-poker-table
#
# With TUNNEL_PROVIDER=ngrok, a reserved domain keeps the public URL stable.
# TUNNEL_PUBLIC_URL skips output parsing and is published to the app directly.
# TUNNEL_DOMAIN=my-table.ngrok-free.dev
# TUNNEL_PUBLIC_URL=https://my-table.ngrok-free.dev

# Ranked beta: automatic 3–6 player tables and all-time BB/100 statistics.
POKER_RANKED_ENABLED=false

# Only these accounts may create public tables. Comma-separated, matched
# against the verified Google email captured at sign-in.
# Empty by default: nobody receives moderator privileges unless configured.
# POKER_MODERATOR_EMAILS=moderator@example.com

# The live-admin API is disabled by default. Enabling it always requires a token
# and direct loopback access; never forward it through your public reverse proxy.
# POKER_ADMIN_LIVE_ENABLED=false
# POKER_ADMIN_LIVE_TOKEN=replace-with-a-long-random-secret

# The lobby always shows one permanent public table. Set false to remove it.
# POKER_HOUSE_TABLE_ENABLED=true
# POKER_HOUSE_TABLE_NAME=House Table
